FROM node:24-alpine

ARG NODE_ENV
ARG START_METHOD
# "node" en production (compose prod), "root" en développement (fichiers montés depuis l'hôte)
ARG APP_USER=root

ENV NODE_ENV=${NODE_ENV}

WORKDIR /usr/src/app

# Le package-lock.json garantit des versions de dépendances identiques à chaque build
COPY package.json package-lock.json ./

RUN if [ "$NODE_ENV" = "production" ]; then \
      npm ci --omit=dev; \
    else \
      npm ci; \
    fi && npm cache clean --force

COPY . .

COPY wait-for-database.sh /usr/wait-for-database.sh
RUN chmod +x /usr/wait-for-database.sh \
    && mkdir -p public/uploads logs \
    && chown -R ${APP_USER}:${APP_USER} /usr/src/app

USER ${APP_USER}

CMD ["sh", "-c", "/usr/wait-for-database.sh db:3306 -- npm run $START_METHOD"]
