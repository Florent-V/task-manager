#########################################
#          COMMON CONFIGURATION         #
#########################################

PROJECT_NAME=starter
ENV_NAME=local
NODE_ENV=development

#########################################
#    MYSQL DATABASE CONFIGURATION       #
#########################################

DB_HOST=${PROJECT_NAME}-db-${ENV_NAME}
DB_USER=user
DB_PASSWORD=password
DB_NAME=mydatabase
DB_ROOT_PASSWORD=rootpassword
DB_PORT=3307

#########################################
#        BACK END CONFIGURATION         #
#########################################

START_METHOD=dev
NODE_API_PORT=3002
NODE_API_DOCKER_PORT=3000

#########################################
#        FRONT END CONFIGURATION        #
#########################################

VITE_CLIENT_PORT=8081
VITE_CLIENT_DOCKER_PORT=8080

#########################################
#            SITE CONFIGURATION         #
#########################################

API_BASE_URL=http://localhost:${NODE_API_PORT}
CLIENT_URL=http://localhost:${VITE_CLIENT_PORT}
CERT_RESOLVER=myresolver
NGINX_CLIENT_PORT=8010

#########################################
#        MAILER CONFIGURATION           #
#########################################
MAILER_HOST=mailpit
MAILER_PORT=1025
MAILER_SECURE=false
MAILER_USER=
MAILER_PASS=
MAIL_FROM="My Kanban App" <noreply@mykanban.app>

#########################################
#           AI CONFIGURATION            #
#########################################
# Provider : mistral | openai | openrouter | nvidia | gemini | ollama (Ollama Cloud)
AI_PROVIDER=mistral
AI_API_URL=
AI_API_KEY=yourAiApiKeyHere
AI_MODEL=

#########################################
#     OAUTH2 / SSO CONFIGURATION        #
#########################################
# Application déclarée sur le serveur OAuth2 (README, section « Authentification SSO ») avec
#   home URL     = ${CLIENT_URL}/
#   redirect URI = ${API_BASE_URL}/api/auth/callback
#   back-channel = ${API_BASE_URL}/api/auth/backchannel-logout

OAUTH_SERVER_URL=http://localhost:8080
OAUTH_CLIENT_ID=task-manager
OAUTH_CLIENT_SECRET=client_secret_shown_once_by_the_oauth_server
OAUTH_REDIRECT_URI=${API_BASE_URL}/api/auth/callback
# Clé publique du serveur (make prod-public-key), sur une ligne avec des \n
OAUTH_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# URL du serveur OAuth2 joignable depuis le conteneur api (appels /token et /api/userinfo), si différente de
# l'URL publique. En dev avec un serveur OAuth sur l'hôte : http://host.docker.internal:8080
OAUTH_INTERNAL_URL=
# « iss » des logout tokens, si différent de OAUTH_SERVER_URL (ex. URL interne Docker vs URL publique)
OAUTH_ISSUER=

#########################################
#          SESSION CONFIGURATION        #
#########################################

COOKIE_SECRET=cookie_secret
# Secret de signature du cookie de session : openssl rand -hex 32
SESSION_SECRET=session_secret
# false seulement si le navigateur refuse les cookies Secure en HTTP (développement hors localhost)
COOKIE_SECURE=true
