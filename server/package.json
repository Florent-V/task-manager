{
  "name": "node-express-mysql-api",
  "version": "1.0.0",
  "description": "Node Express MySQL API",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "make:crud": "node src/generate/generate-entity.js",
    "db:sync": "node src/database/sync.js",
    "db:sync:force": "node src/database/sync.js --force",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "migration:generate": "sequelize-cli migration:generate --migrations-path migrations --name",
    "oauth:export-users": "node src/database/exportUsersForOAuth.js"
  },
  "keywords": [
    "node",
    "express",
    "mysql",
    "api",
    "rest",
    "jwt",
    "authentication",
    "authorization",
    "sequelize"
  ],
  "author": "Florent Vasseur",
  "license": "ISC",
  "dependencies": {
    "@adminjs/express": "6.1.1",
    "@adminjs/sequelize": "^4.1.1",
    "adminjs": "^7.8.15",
    "body-parser": "^1.20.9",
    "connect-session-sequelize": "^8.0.6",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-session": "^1.19.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.12.0",
    "nodemailer": "^6.9.0",
    "openai": "^4.104.0",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.3",
    "sequelize-cli": "^6.6.5",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.27.5",
    "@eslint/js": "^9.28.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-n": "^17.19.0",
    "eslint-plugin-prettier": "^5.4.1",
    "globals": "^17.13.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.5.3"
  },
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1"
  }
}
